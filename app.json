{
  "expo": {
    "name": "Mon Budget",
    "slug": "gestion-financiere-afrique",
    "scheme": "monequilibre",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diamars.monequilibre"
    },
    "android": {
      "package": "com.diamars.monequilibre",
      "adaptiveIcon": {
        "backgroundColor": "#087F5B"
      }
    },
    "plugins": [
      "expo-router",
      ["expo-sqlite", { "enableFTS": true }],
      "expo-notifications"
    ],
    "experiments": { "typedRoutes": true }
  }
}
